{
  "name": "@romtenma/bbsync",
  "version": "3.1.0",
  "description": "Simple per-device state synchronization for bulletin board clients",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "examples/**/*.mjs",
    "docs/**/*.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/bbsync.test.js dist/sync-level.test.js dist/local-state-store.contract.test.js dist/server.test.js dist/application-snapshot.test.js dist/http-state-store.test.js dist/adapter.test.js",
    "test:package": "node scripts/test-package.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "prepack": "npm test && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romtenma/bbsync.git"
  },
  "bugs": {
    "url": "https://github.com/romtenma/bbsync/issues"
  },
  "homepage": "https://github.com/romtenma/bbsync#readme",
  "keywords": [
    "bbs",
    "sync",
    "json",
    "state-store"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.0"
  }
}
