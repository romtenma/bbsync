{
  "name": "@romtenma/bbsync",
  "version": "2.2.0",
  "description": "JSONL-based synchronization primitives for bulletin board clients",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/event-store.contract.js",
    "!dist/event-store.contract.d.ts",
    "docs/**/*.md",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/bbsync.test.js dist/local-event-store.contract.test.js dist/site.test.js",
    "prepack": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romtenma/bbsync.git"
  },
  "bugs": {
    "url": "https://github.com/romtenma/bbsync/issues"
  },
  "homepage": "https://github.com/romtenma/bbsync#readme",
  "keywords": [
    "bbs",
    "sync",
    "jsonl",
    "event-store"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.0"
  }
}
